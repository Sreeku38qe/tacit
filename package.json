{
  "name": "tacit",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A silence procedure for Sputnik DAO budgets: a spend passes unless someone objects in time.",
  "license": "MIT",
  "scripts": {
    "site": "node scripts/serve.mjs",
    "demo": "node scripts/serve.mjs --demo",
    "verify": "node scripts/verify.mjs",
    "e2e": "node scripts/e2e.mjs",
    "evidence": "node scripts/evidence.mjs",
    "build:wallet": "esbuild scripts/wallet-entry.js --bundle --format=esm --minify --platform=browser --outfile=web/vendor/near-connect.js"
  },
  "dependencies": {
    "near-api-js": "^7.4.0"
  },
  "devDependencies": {
    "@hot-labs/near-connect": "^0.12.0",
    "esbuild": "^0.25.9",
    "playwright-core": "^1.65.0"
  }
}
